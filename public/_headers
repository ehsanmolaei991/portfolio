# Cloudflare (and Netlify-style) headers. Copied verbatim into out/ by the
# static export, and applied by Cloudflare Workers/Pages static assets.
#
# Keep this in sync with the app: the CSP below is what actually constrains the
# page, so adding an external script/font/image host means editing it here.

/*
  # HTML must revalidate. Without this, Cloudflare applies s-maxage=604800 and
  # every page sits in the edge cache for a WEEK — a deployment then takes days
  # to reach anyone, and pages deleted from the build keep serving 200 from
  # cache. Fingerprinted assets below opt back into long caching.
  Cache-Control: public, max-age=0, must-revalidate
  # HSTS. Only meaningful once the site is confirmed working over HTTPS —
  # preload is intentionally omitted; add it only when you are sure.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # 'unsafe-inline' for styles is required by Next's inlined critical CSS;
  # 'unsafe-inline' for scripts is required by the Next bootstrap script.
  # There is no external origin in the allow-list because the site loads none.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Fingerprinted build assets — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The résumé PDF changes when regenerated; let the CDN hold it briefly.
/*.pdf
  Cache-Control: public, max-age=3600, must-revalidate

/og.png
  Cache-Control: public, max-age=86400
