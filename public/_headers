# Cloudflare Pages headers. Copied verbatim into out/ by the static export.
#
# Keep this in sync with the app: the CSP below is what actually constrains the
# page, so adding an external script/font/image host means editing it here.

# ---------------------------------------------------------------------------
# Security — applies to every response.
# ---------------------------------------------------------------------------
/*
  # HSTS. Only meaningful once the site is confirmed working over HTTPS —
  # preload is intentionally omitted; add it only when you are sure.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # 'unsafe-inline' for styles is required by Next's inlined critical CSS;
  # 'unsafe-inline' for scripts is required by the Next bootstrap script.
  # There is no external origin in the allow-list because the site loads none.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# ---------------------------------------------------------------------------
# Cache-Control
#
# CAREFUL: Cloudflare APPENDS the headers of every matching rule rather than
# letting the most specific one win. A Cache-Control on /* therefore does not
# override the asset rules below — it concatenates with them and produces
#
#   cache-control: public, max-age=0, must-revalidate, public, max-age=31536000, immutable
#
# which browsers resolve to the FIRST max-age, silently killing the long cache.
# So every path must match exactly ONE rule here. That is why the HTML routes
# are listed individually instead of using /*.
#
# If you add a route, add it here too, or it falls back to Cloudflare's default
# (s-maxage=604800 — a week of edge caching, which means deploys stop showing).
# ---------------------------------------------------------------------------

# Fingerprinted build output — the filename changes when the content does.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Regenerated by `npm run pdf`; short TTL so a new one propagates the same day.
/*.pdf
  Cache-Control: public, max-age=3600, must-revalidate

/og.png
  Cache-Control: public, max-age=86400

# HTML and metadata — always revalidate, so a deploy is visible immediately
# and a deleted page stops being served.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.txt
  Cache-Control: public, max-age=0, must-revalidate

/resume/*
  Cache-Control: public, max-age=0, must-revalidate

/work/*
  Cache-Control: public, max-age=0, must-revalidate

/404
  Cache-Control: public, max-age=0, must-revalidate

/404/*
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
